# ── Secrets ──
# .env lives at the repo root and holds OPENAI_API_KEY.
.env
*.local

# ── Private ──
# CLAUDE.md is working guidance between the maintainer and Claude Code — not shipped.
CLAUDE.md
# notes.txt holds personal `claude --resume` session commands — ephemeral.
notes.txt

# ── Python backend (app/) + venv ──
scryer/            # committed venv → now rebuilt from requirements.txt, not tracked
__pycache__/
*.pyc
.mypy_cache/

# ── Node / frontend tooling ──
node_modules/
dist/

# ── Model binaries ──
# Large ONNX weights (Piper voices + emotion net) live in BOTH the repo-root
# models/ and frontend/public/models/ (the latter is served to the browser).
# Never commit them anywhere — download links are documented in README.md.
# Un-anchored so it matches at any depth (the old `models/*.onnx` only caught
# the repo-root copy and let frontend/public/models/*.onnx slip in).
*.onnx
*.onnx.json

# ── Logs ──
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ── Editor / OS ──
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.sw?
